<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Secure SSO Hub</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <%= link_to "Secure SSO Hub", root_path, class: "brand" %>
      <nav>
        <% if user_signed_in? %>
          <span class="muted"><%= current_user.email %></span>
          <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "link-button" %>
        <% else %>
          <%= link_to "Sign in", new_user_session_path %>
        <% end %>
      </nav>
    </header>

    <main class="container">
      <% flash.each do |type, message| %>
        <p class="flash flash-<%= type %>" role="status"><%= message %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
